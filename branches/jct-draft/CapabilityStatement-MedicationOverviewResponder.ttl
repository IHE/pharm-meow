     fhir:v "http://profiles.ihe.net/PHARM/MEOW/CapabilityStatement/MedicationOverviewResponder"^^xsd:anyURI ;
     fhir:l <http://profiles.ihe.net/PHARM/MEOW/CapabilityStatement/MedicationOverviewResponder>
  ] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "MedicationOverviewResponder"] ; # 
  fhir:title [ fhir:v "Medication Overview Responder"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
