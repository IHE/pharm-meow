     ] )
  ] ) ; # 
  fhir:description [ fhir:v "CapabilityStatement for the Medication Overview Responder actor in the IHE PHARM MEOW profile.\n\nThe Responder is a server that stores and/or assembles medication overview data for patients\nand serves it in response to Consumer requests. It supports PHARM-11 (Query Medication\nResources) as a required capability, and optionally PHARM-12 (Retrieve Medication Document)\nwhen the Document Option is declared.\n\nHow the Responder obtains its data (continuous store, on-demand aggregation, document\nassembly) is an implementation concern outside the scope of this profile."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ]
     ] )
  ] ) ; # 
  fhir:copyright [ fhir:v "IHE http://www.ihe.net/Governance/#Intellectual_Property"] ; # 
  fhir:kind [ fhir:v "requirements"] ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:format ( [ fhir:v "application/fhir+json"] [ fhir:v "application/fhir+xml"] ) ; # 
  fhir:rest ( [
     fhir:mode [ fhir:v "server" ] ;
     fhir:documentation [ fhir:v "The Responder responds to PHARM-11 search queries with searchset Bundles containing\nMedicationTreatmentLine resources. With the Document Option, it also responds to\nPHARM-12 requests with MedicationOverviewBundle documents." ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "MedicationStatement" ] ;
       fhir:supportedProfile ( [
         fhir:v "http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/MedicationTreatmentLine"^^xsd:anyURI ;
         fhir:l <http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/MedicationTreatmentLine>
       ] ) ;
       fhir:documentation [ fhir:v "The Repository SHALL support search on MedicationStatement using the defined\nsearch parameters. The patient parameter is required on all searches." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "read" ]
       ] ) ;
       fhir:searchInclude ( [ fhir:v "MedicationStatement:medication" ] [ fhir:v "MedicationStatement:basedOn" ] [ fhir:v "MedicationStatement:partOf" ] ) ;
       fhir:searchRevInclude ( [ fhir:v "MedicationDispense:prescription" ] [ fhir:v "MedicationAdministration:request" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "patient" ] ;
         fhir:type [ fhir:v "reference" ] ;
         fhir:documentation [ fhir:v "Required. Patient whose treatment lines are requested." ]
       ] [
         fhir:name [ fhir:v "status" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filter by treatment line status." ]
       ] [
         fhir:name [ fhir:v "effective" ] ;
         fhir:type [ fhir:v "date" ] ;
         fhir:documentation [ fhir:v "Filter by effective period." ]
       ] [
         fhir:name [ fhir:v "category" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filter by list category / type." ]
       ] [
         fhir:name [ fhir:v "_lastUpdated" ] ;
         fhir:type [ fhir:v "date" ] ;
         fhir:documentation [ fhir:v "Filter by last update time (incremental sync support)." ]
       ] )
     ] [
       fhir:type [ fhir:v "CarePlan" ] ;
       fhir:supportedProfile ( [
         fhir:v "http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/MedicationTreatment"^^xsd:anyURI ;
         fhir:l <http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/MedicationTreatment>
       ] ) ;
       fhir:documentation [ fhir:v "Returned as an _include of MedicationStatement:partOf when MedicationTreatment grouping is present." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationRequest" ] ;
       fhir:documentation [ fhir:v "Optionally returned as _include of MedicationStatement:basedOn (prescriptions)." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationDispense" ] ;
       fhir:documentation [ fhir:v "Optionally returned as _revinclude of MedicationDispense:prescription." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationAdministration" ] ;
       fhir:documentation [ fhir:v "Optionally returned as _revinclude of MedicationAdministration:request." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "Medication" ] ;
       fhir:supportedProfile ( [
         fhir:v "http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/IHEMedication"^^xsd:anyURI ;
         fhir:l <http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/IHEMedication>
       ] ) ;
       fhir:documentation [ fhir:v "Optionally returned as _include of MedicationStatement:medication." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "Bundle" ] ;
       fhir:supportedProfile ( [
         fhir:v "http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/MedicationOverview"^^xsd:anyURI ;
         fhir:l <http://profiles.ihe.net/PHARM/MEOW/StructureDefinition/MedicationOverview>
       ] ) ;
       fhir:documentation [ fhir:v "Document Option (PHARM-12). The Repository stores and serves MedicationOverviewBundle\ndocuments. Supports retrieval by logical id and by patient/type/date search." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "type" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Filter by document type / medication list category." ]
       ] [
         fhir:name [ fhir:v "patient" ] ;
         fhir:type [ fhir:v "reference" ] ;
         fhir:documentation [ fhir:v "Required for patient-scoped document search." ]
       ] [
         fhir:name [ fhir:v "date" ] ;
         fhir:type [ fhir:v "date" ] ;
         fhir:documentation [ fhir:v "Filter by document creation date." ]
       ] )
     ] )
  ] ) . # 

